---
export interface Props {
  name: string;
  size?: "sm" | "lg";
}

const { name, size = "sm" } = Astro.props;
---

<li class="inline-flex">
  <a
    href={`/tags/${name.toLowerCase()}`}
    class={`group inline-flex items-center gap-1 rounded-full border border-skin-line bg-skin-card bg-opacity-30 no-underline transition hover:-translate-y-0.5 hover:border-skin-accent hover:bg-opacity-60 hover:text-skin-accent ${
      size === "sm" ? "px-2.5 py-1 text-sm" : "px-3 py-1.5 text-lg"
    }`}
  >
    <span aria-hidden="true" class="font-semibold text-skin-accent">#</span>
    <span>{name.toLowerCase()}</span>
  </a>
</li>
