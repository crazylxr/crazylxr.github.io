---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Comments from "@components/Comments.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";

const pageTitle = `About | ${SITE.title}`;
const pageDescription =
  "关于桃翁：前端工程师、ahooks 开源维护者，以及《用一家奶茶店学会股票投资》的作者。";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header activeNav="about" />
  <Breadcrumbs />

  <main id="main-content">
    <section class="about-hero" aria-labelledby="about-title">
      <h1 id="about-title">
        写代码，也写下<br />
        我如何理解世界。
      </h1>

      <p class="intro">嗨，我是桃翁，目前在蚂蚁集团做前端工程师。</p>

      <div class="story">
        <p>
          白天和代码、产品打交道，把想法变成真正可用的东西；业余时间读书、研究投资，也会折腾一些自己感兴趣的事情。
        </p>
        <p>
          这个博客没有特别固定的主题。这里有技术实践，有投资思考，也有我在不同阶段对工作与生活的理解。写下这些，一方面是为了整理自己，另一方面也希望其中某些内容能对你有用。
        </p>
      </div>
    </section>

    <section class="work" aria-label="我在做的事">
      <article>
        <p class="eyebrow">开源</p>
        <h2>ahooks</h2>
        <p>参与维护一套高质量、可靠易用的 React Hooks 库。</p>
        <a
          class="action"
          href="https://github.com/alibaba/hooks"
          target="_blank"
          rel="noopener noreferrer"
        >
          查看项目 <span aria-hidden="true">→</span>
        </a>
      </article>

      <article>
        <p class="eyebrow">写作</p>
        <h2>前端桃园</h2>
        <p>在公众号分享前端工程、成长经历与长期思考。</p>
        <button
          id="wechat-dialog-trigger"
          class="action"
          type="button"
          aria-haspopup="dialog"
        >
          关注公众号 <span aria-hidden="true">→</span>
        </button>
      </article>

      <article class="book">
        <p class="eyebrow">一本书</p>
        <h2>用一家奶茶店学会股票投资</h2>
        <p>把投资知识放进真实生意场景，从零理解一门长期的功课。</p>
        <a
          class="action"
          href="https://qinghe.taoweng.site/"
          target="_blank"
          rel="noopener noreferrer"
        >
          开始阅读 <span aria-hidden="true">→</span>
        </a>
      </article>
    </section>

    <dialog id="wechat-dialog" aria-labelledby="wechat-dialog-title">
      <div class="dialog-header">
        <div>
          <p class="eyebrow">微信公众号</p>
          <h2 id="wechat-dialog-title">前端桃园</h2>
        </div>
        <button id="wechat-dialog-close" type="button">关闭</button>
      </div>
      <img
        src="/assets/wechat-official-account.jpg"
        width="430"
        height="430"
        alt="前端桃园微信公众号二维码"
      />
      <p class="dialog-hint">打开微信扫一扫，关注「前端桃园」</p>
    </dialog>

    <section class="why-write" aria-labelledby="why-write-title">
      <h2 id="why-write-title">为什么写</h2>
      <p>写作是我整理自己思考的方式。</p>
      <p>
        把模糊的想法写下来，才能看清它的轮廓；把经验沉淀成文字，才能在未来复用。如果这些内容恰好能帮到你，那就更有意义了。
      </p>
    </section>

    <section class="comments" aria-label="评论">
      <Comments />
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-3xl px-4 pb-20 pt-12 sm:pb-28 sm:pt-16;
  }

  .about-hero h1 {
    @apply m-0 text-[2rem] font-medium leading-[1.45] tracking-[0.08em] sm:text-[2.6rem] sm:leading-[1.5];
  }

  .intro {
    @apply mb-0 mt-8 text-base font-medium leading-8 sm:mt-9 sm:text-lg;
  }

  .story {
    @apply mt-8 max-w-[46rem] space-y-5 leading-8;
  }

  .story p {
    @apply m-0;
  }

  .work {
    @apply mt-10 grid border-y border-skin-line sm:grid-cols-3;
  }

  .work article {
    @apply flex min-w-0 flex-col border-b border-skin-line py-7 last:border-b-0 sm:border-b-0 sm:border-r sm:px-8 sm:first:pl-0 sm:last:border-r-0 sm:last:pr-0;
  }

  .eyebrow {
    @apply m-0 text-sm opacity-60;
  }

  .work h2 {
    @apply mb-0 mt-4 break-words text-xl font-semibold leading-8;
  }

  .work article > p:not(.eyebrow) {
    @apply mb-0 mt-4 text-sm leading-7 opacity-80;
  }

  .work .action {
    @apply mt-auto w-fit pt-5 font-semibold text-skin-accent underline decoration-dashed underline-offset-8;
  }

  .work button.action {
    @apply text-left;
  }

  .work .action:hover {
    @apply decoration-solid;
  }

  .work .action:focus-visible {
    @apply rounded-sm outline-dashed outline-2 outline-offset-4;
    outline-color: rgb(var(--color-accent));
  }

  .book h2,
  .book a {
    @apply font-bold;
  }

  dialog {
    @apply m-auto w-[calc(100%-2rem)] max-w-sm border border-skin-line bg-skin-fill p-5 text-skin-base sm:p-6;
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .dialog-header {
    @apply mb-5 flex items-start justify-between gap-4;
  }

  .dialog-header h2 {
    @apply mb-0 mt-2 text-xl font-semibold;
  }

  .dialog-header button {
    @apply text-sm text-skin-accent underline decoration-dashed underline-offset-4 hover:decoration-solid;
  }

  dialog img {
    @apply aspect-square h-auto w-full;
  }

  .dialog-hint {
    @apply mb-0 mt-5 text-center text-sm leading-6 opacity-70;
  }

  .why-write {
    @apply px-0 pt-9;
  }

  .why-write h2 {
    @apply m-0 text-2xl font-semibold tracking-wide;
  }

  .why-write p {
    @apply mb-0 mt-5 max-w-[46rem] leading-8;
  }

  .comments {
    @apply mt-12 border-t border-skin-line pt-10;
  }
</style>

<script>
  const wechatDialog =
    document.querySelector<HTMLDialogElement>("#wechat-dialog");
  const wechatDialogTrigger = document.querySelector<HTMLButtonElement>(
    "#wechat-dialog-trigger"
  );
  const wechatDialogClose = document.querySelector<HTMLButtonElement>(
    "#wechat-dialog-close"
  );

  wechatDialogTrigger?.addEventListener("click", () => {
    wechatDialog?.showModal();
  });

  wechatDialogClose?.addEventListener("click", () => {
    wechatDialog?.close();
  });

  wechatDialog?.addEventListener("click", event => {
    if (event.target === wechatDialog) {
      wechatDialog.close();
    }
  });
</script>
